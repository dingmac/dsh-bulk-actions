{
  "name": "@local/dsh-bulk-actions",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "侧栏任务多选与批量操作：批量归档、永久删除会话，并在任务右键菜单里加入「删除会话」与「多选模式」。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
